# app/.env — copy to app/.env and fill in the three API keys. NEVER commit .env.
# Everything below except the keys mirrors the live Reachy Mini (2026-08-25).
# Wake-word / latency / feature flags live in the systemd drop-in instead:
#   /etc/systemd/system/supervaise.service.d/wakeword.conf
#   (source: deploy/pi/systemd/supervaise.service.d/wakeword.conf)

# --- Required API keys ---------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ElevenLabs: the CJ voice clone. Key needs text_to_speech (+ forced_alignment
# for scripts/backfill_alignments.py). Voice ID = the cloned CJP voice.
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=LeM5jaQwKcHJtzmSBNlA

# --- Speech backends -----------------------------------------------
CJ_TTS_BACKEND=elevenlabs
CJ_ELEVEN_RESPELL=1
CJ_WAKE_WORD_ENABLED=1
CJ_WAKE_STT_BACKEND=openai
# Legacy laptop-only settings (unused on the robot; harmless):
WHISPER_MODEL=medium
PIPER_BIN=./piper/piper.exe
PIPER_VOICE=./voices/en_US-ryan-high.onnx

# --- Composer ------------------------------------------------------
# Composer = Sonnet (default). To run on Haiku for speed (plainer prose):
# INFERENCE_MODEL=claude-haiku-4-5-20251001
# Skip the Haiku fidelity round-trip after composition (saves ~1.5-3s/turn;
# the async audit in wakeword.conf still runs during playback).
CJ_SKIP_FIDELITY=1
# Fixed fallback cap; the per-theme dynamic budget (CJ_DYNAMIC_TOKENS_ENABLED)
# normally wins.
CJ_COMPOSER_MAX_TOKENS=300
CJ_COMPOSER_EFFORT=

# --- Input gate ----------------------------------------------------
CJ_ANSWER_GATE_ENABLED=1
CJ_ANSWER_GATE_LOG_PATH=/dev/shm/cj_answer_gate.jsonl

# --- Two-robot personas (2026-09-10) ---------------------------------
# ELEVEN_VOICE_ID above is Panganiban's cloned voice. The Host's voice is
# only used by the render scripts (intro variants, duet) — never live.
ELEVEN_HOST_VOICE_ID=
