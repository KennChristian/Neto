pcm.!default {
    type asym
    playback.pcm "reachymini_audio_sink"
    capture.pcm "reachymini_audio_src_plug"
}
ctl.!default {
    type hw
    card 0
}
# Playback goes through pcm.audio_out_route, whose real definition lives in
# ~/.asoundrc.route and is rewritten by ~/bin/audio-out (internal speaker via
# PipeWire, or a Bluetooth speaker via BlueALSA). The pulse definition below
# is only a fallback in case the route file is missing.
# Pre-route original backed up at ~/.asoundrc.bak-pre-route-20260804;
# older BT-hardwired version at ~/.asoundrc.bak-ult-field-20260803.
pcm.reachymini_audio_sink {
    type plug
    slave.pcm "audio_out_route"
}
pcm.audio_out_route {
    type pulse
}
@hooks [
    {
        func load
        files [
            "/home/pollen/.asoundrc.route"
        ]
        errors false
    }
]
pcm.reachymini_audio_src_plug {
    type plug
    slave.pcm "reachymini_audio_src"
}
pcm.reachymini_audio_src {
    type dsnoop
    ipc_key 4242
    slave {
        pcm "hw:0,0"
        channels 2
        rate 16000
        period_size 256
        buffer_size 1024
    }
}
